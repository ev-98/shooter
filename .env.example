SAVE_HMAC_KEY=your_secret_key_here
# Only needed to override the production default (see version.py) — e.g.
# SERVER_URL=ws://localhost:8765 for local dev against `python server.py`.
SERVER_URL=wss://your.domain.example
# Steamworks app id (see steam_integration.py). Leave unset/0 until the
# Steamworks subscription is active and an app id is assigned — Steam
# features stay off and the game runs exactly as it does today.
STEAM_APP_ID=0
